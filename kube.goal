// kube supports running jobs on a Kubernetes cluster, with kubectl: each
// simmer job is a standard Indexed Job, with one pod per run
// ([JobParams.NRuns]), like a slurm array job, each running job.sbatch
// with its run number from JOB_COMPLETION_INDEX.
//
// The pods run the sim in the results directory of the job on a shared
// volume ([KubeParams.SharedPVC]), so that the results are there while
// the job runs, and are kept after the Job is deleted. The local machine
// cannot mount that volume, so simmer uploads the job files to it, reads
// the status files, and fetches the results, through a small helper pod
// that mounts it (see [Simmer.kubeHelper]), with kubectl exec.
//
// The Astera server (astera.go) uses all of this but for the Job itself,
// which is an actl Queue Entry, whose source is uploaded by actl.
//
// The kubectl commands run as goal shell commands on the local host (@0),
// so their output (to the terminal) shows what they did. Each operation
// starts with [Simmer.kubeStart], and gets the errors of its commands
// with [goalError].

// kubeNamespace returns the namespace of the jobs.
func (sr *Simmer) kubeNamespace() string {
	return sr.Project.Server.K8s.Namespace
}

// kubePVC returns the name of the shared volume of the results.
func (sr *Simmer) kubePVC() string {
	k := &sr.Project.Server.K8s
	if k.SharedPVC != "" {
		return k.SharedPVC
	}
	return k.Namespace + "-shared"
}

// kubeMount returns the path of the shared volume in the pods.
func (sr *Simmer) kubeMount() string {
	return path.Join("/mnt", sr.kubePVC())
}

// KubeJobPath returns the absolute path of the results directory of the
// given job, on the shared volume, in the pods.
func (sr *Simmer) KubeJobPath(jid string) string {
	return path.Join(sr.kubeMount(), filepath.ToSlash(sr.ServerJobPath(jid)))
}

var kubeNameRE = regexp.MustCompile(`[^a-z0-9-]+`)

// kubeName returns s as a valid Kubernetes name: lowercase letters,
// digits and dashes, starting and ending with a letter or digit.
func kubeName(s string) string {
	s = kubeNameRE.ReplaceAllString(strings.ToLower(s), "-")
	s = strings.Trim(s, "-")
	if len(s) > 40 { // room for the suffixes that actl and Kubernetes add
		s = strings.Trim(s[:40], "-")
	}
	return s
}

// kubeJobName returns the name of the Kubernetes Job of the given job,
// which is the prefix of the name of its actl Queue Entry for Astera.
func (sr *Simmer) kubeJobName(jid string) string {
	return kubeName(sr.Project.Name + "-" + jid)
}

// kubeHelperName returns the name of the helper pod of the user.
func (sr *Simmer) kubeHelperName() string {
	return kubeName("simmer-" + sr.Project.User + "-" + sr.kubePVC())
}

// kubeLabels returns the labels of the Job of the given job and its pods,
// with the [KubeParams.Labels], sorted by key.
func (sr *Simmer) kubeLabels(jid string) [][2]string {
	lb := map[string]string{
		"app.kubernetes.io/managed-by": "simmer",
		"simmer/user":                  kubeName(sr.Project.User),
		"simmer/project":               kubeName(sr.Project.Name),
		"simmer/job":                   kubeName(jid),
	}
	for k, v := range sr.Project.Server.K8s.Labels {
		lb[k] = v
	}
	return sortedPairs(lb)
}

// sortedPairs returns the key, value pairs of the given map, sorted by key.
func sortedPairs(m map[string]string) [][2]string {
	var ps [][2]string
	for k, v := range m {
		ps = append(ps, [2]string{k, v})
	}
	slices.SortFunc(ps, func(a, b [2]string) int { return strings.Compare(a[0], b[0]) })
	return ps
}

// kubeScheduling returns the node selector and tolerations of the pods,
// which are those of the [KubeParams] for Kube, and of the pool of the
// namespace for Astera (see [Simmer.asteraScheduling]).
func (sr *Simmer) kubeScheduling() (map[string]string, []string) {
	if sr.Project.Server.Server == Astera {
		return sr.asteraScheduling()
	}
	k := &sr.Project.Server.K8s
	return k.NodeSelector, k.Tolerations
}

// writeKubeScheduling writes the nodeSelector and tolerations of a pod
// spec, with the given indent, from [Simmer.kubeScheduling].
func (sr *Simmer) writeKubeScheduling(w io.Writer, ind string) {
	sel, tols := sr.kubeScheduling()
	if len(sel) > 0 {
		fmt.Fprintf(w, "%snodeSelector:\n", ind)
		for _, p := range sortedPairs(sel) {
			fmt.Fprintf(w, "%s  %s: %q\n", ind, p[0], p[1])
		}
	}
	if len(tols) > 0 {
		fmt.Fprintf(w, "%stolerations:\n", ind)
		for _, t := range tols {
			key, effect, ok := strings.Cut(t, ":")
			if !ok {
				effect = "NoSchedule"
			}
			fmt.Fprintf(w, "%s- {key: %s, operator: Exists, effect: %s}\n", ind, key, effect)
		}
	}
}

// kubeStart starts a kube operation: it clears the errors of the goal
// commands (see [clearErrors]), and makes the local host the default one
// for them (see [Simmer.kubeEnv]).
func (sr *Simmer) kubeStart() {
	clearErrors()
	sr.kubeEnv()
}

// kubeEnv makes the local host the default one for the goal commands, and
// sets KUBECONFIG to [KubeParams.Kubeconfig] if it is set, or to the one
// of actl for Astera if KUBECONFIG is not set (see [asteraEnv]).
func (sr *Simmer) kubeEnv() {
	if kc := sr.Project.Server.K8s.Kubeconfig; kc != "" {
		if strings.HasPrefix(kc, "~/") {
			if home, err := os.UserHomeDir(); err == nil {
				kc = filepath.Join(home, kc[2:])
			}
		}
		os.Setenv("KUBECONFIG", kc)
	} else if sr.Project.Server.Server == Astera {
		asteraEnv()
	}
	@0
}

// goalError returns the errors of the goal commands since the start of
// the operation (their messages are in the terminal).
func goalError() error {
	return errors.Join(goalrun.Errors...)
}

// kubePodSecurity is the securityContext of the pods: they run as nobody,
// not root, as the policies of clusters may require, which also owns the
// files on the shared (NFS) volumes that squash the users to it.
const kubePodSecurity = "securityContext: {runAsNonRoot: true, runAsUser: 65534, runAsGroup: 65534}"

// kubeContainerSecurity is the securityContext of the containers of the pods.
const kubeContainerSecurity = "securityContext: {allowPrivilegeEscalation: false}"

// WriteKubeHelper writes the manifest of the helper pod, which only
// mounts the shared volume, for kubectl exec to upload the job files,
// read the status files and fetch the results. It is scheduled as the
// pods of the jobs (see [Simmer.kubeScheduling]), as the shared volume
// may mount only on their nodes, but uses no GPU.
func (sr *Simmer) WriteKubeHelper(w io.Writer) {
	ns := sr.kubeNamespace()
	fmt.Fprintf(w, "apiVersion: v1\nkind: Pod\nmetadata:\n")
	fmt.Fprintf(w, "  name: %s\n  namespace: %s\n", sr.kubeHelperName(), ns)
	fmt.Fprintf(w, "  labels:\n")
	fmt.Fprintf(w, "    app.kubernetes.io/name: simmer-helper\n")
	fmt.Fprintf(w, "    app.kubernetes.io/managed-by: simmer\n")
	fmt.Fprintf(w, "    simmer/user: %s\n", kubeName(sr.Project.User))
	fmt.Fprintf(w, "spec:\n  restartPolicy: Always\n  terminationGracePeriodSeconds: 1\n")
	fmt.Fprintf(w, "  %s\n", kubePodSecurity)
	sr.writeKubeScheduling(w, "  ")
	fmt.Fprintf(w, "  containers:\n  - name: data\n    image: alpine:3.21\n    command: [sleep, infinity]\n")
	fmt.Fprintf(w, "    %s\n", kubeContainerSecurity)
	fmt.Fprintf(w, "    resources:\n      requests: {cpu: 10m, memory: 32Mi}\n      limits: {cpu: \"1\", memory: 512Mi}\n")
	fmt.Fprintf(w, "    volumeMounts:\n    - name: shared\n      mountPath: %s\n", sr.kubeMount())
	fmt.Fprintf(w, "  volumes:\n  - name: shared\n    persistentVolumeClaim:\n      claimName: %s\n", sr.kubePVC())
}

// kubeHelper makes sure that the helper pod is running, creating it if
// it is not there, and returns its name.
func (sr *Simmer) kubeHelper() (string, error) {
	sr.kubeEnv()
	ns := sr.kubeNamespace()
	pod := sr.kubeHelperName()
	if helperReady(ns + "/" + pod) {
		return pod, nil
	}
	jp := "jsonpath={.status.phase}"
	phase := $kubectl -n {ns} get pod {pod} --ignore-not-found -o {jp}$
	if err := goalError(); err != nil {
		return pod, err
	}
	if phase == "Running" {
		setHelperReady(ns+"/"+pod, true)
		return pod, nil
	}
	if phase == "" {
		fmt.Println("Simmer: creating the helper pod:", pod)
		var b bytes.Buffer
		sr.WriteKubeHelper(&b)
		mf := filepath.Join(os.TempDir(), pod+".yaml")
		os.WriteFile(mf, b.Bytes(), 0644)
		kubectl -n {ns} apply -f {mf}
		os.Remove(mf)
	}
	kubectl -n {ns} wait --for=condition=Ready {"pod/"+pod} --timeout=180s
	err := goalError()
	setHelperReady(ns+"/"+pod, err == nil)
	return pod, err
}

// helperChecked has the time each helper pod (namespace/name) was last
// found to be running, so that it is checked (one kubectl call) at most
// every [helperCheckInterval], not before every exec.
var (
	helperMu      sync.Mutex
	helperChecked = map[string]time.Time{}
)

const helperCheckInterval = 2 * time.Minute

// helperError returns err, after which the helper pod is checked again
// before the next exec, if err is not nil.
func (sr *Simmer) helperError(err error) error {
	if err != nil {
		setHelperReady(sr.kubeNamespace()+"/"+sr.kubeHelperName(), false)
	}
	return err
}

func helperReady(key string) bool {
	helperMu.Lock()
	defer helperMu.Unlock()
	return time.Since(helperChecked[key]) < helperCheckInterval
}

// setHelperReady records that the helper pod is running (ok), or that it
// must be checked again before the next exec (!ok, after an error).
func setHelperReady(key string, ok bool) {
	helperMu.Lock()
	defer helperMu.Unlock()
	if ok {
		helperChecked[key] = time.Now()
	} else {
		delete(helperChecked, key)
	}
}

// kubeExec runs the given sh script in the helper pod, returning its output.
func (sr *Simmer) kubeExec(script string) (string, error) {
	pod, err := sr.kubeHelper()
	if err != nil {
		return "", err
	}
	ns := sr.kubeNamespace()
	out := $kubectl -n {ns} exec {pod} -- sh -c {script} < /dev/null$
	return out, sr.helperError(goalError())
}

// kubeExecTo runs the given sh script in the helper pod, with its output
// to the given local file, for binary output.
func (sr *Simmer) kubeExecTo(script, file string) error {
	pod, err := sr.kubeHelper()
	if err != nil {
		return err
	}
	ns := sr.kubeNamespace()
	kubectl -n {ns} exec {pod} -- sh -c {script} < /dev/null > {file}
	return sr.helperError(goalError())
}

// kubeExecFrom runs the given sh script in the helper pod, with its input
// from the given local file.
func (sr *Simmer) kubeExecFrom(script, file string) error {
	pod, err := sr.kubeHelper()
	if err != nil {
		return err
	}
	ns := sr.kubeNamespace()
	kubectl -n {ns} exec -i {pod} -- sh -c {script} < {file}
	return sr.helperError(goalError())
}

// kubeShell is the kubesh command of the terminal: it runs an interactive
// shell (sh) in the helper pod, in the jobs directory of the project on
// the shared volume, or, with args, runs them there as a sh command.
func (sr *Simmer) kubeShell(args ...string) {
	if st := sr.Project.Server.Server; st != Kube && st != Astera {
		fmt.Println("kubesh: the server of the project is not Kube or Astera")
		return
	}
	sr.kubeStart()
	pod, err := sr.kubeHelper()
	if err != nil {
		fmt.Println("kubesh:", err)
		return
	}
	ns := sr.kubeNamespace()
	cd := "cd " + shq(path.Dir(sr.KubeJobPath("_"))) + " 2>/dev/null; "
	if len(args) > 0 {
		cmd := cd + strings.Join(args, " ")
		kubectl -n {ns} exec {pod} -- sh -c {cmd} < /dev/null
		return
	}
	sh := cd + "exec sh"
	kubectl -n {ns} exec -it {pod} -- sh -c {sh}
}

// shq quotes s for sh.
func shq(s string) string {
	return "'" + strings.ReplaceAll(s, "'", `'\''`) + "'"
}

// kubeSourceDir returns the directory in the pods that has the job files:
// for Kube, .src in the results directory, where simmer uploads them
// (see [Simmer.kubeUpload]), and for Astera, the workspace of the Entry,
// where actl uploads them.
func (sr *Simmer) kubeSourceDir(jid string) string {
	if sr.Project.Server.Server == Astera {
		return "/home/dev/workspace"
	}
	return path.Join(sr.KubeJobPath(jid), ".src")
}

// WriteKubeScript writes the job.sbatch script that each pod of the job
// runs: it runs the sim in the results directory on the shared volume,
// for the run given by JOB_COMPLETION_INDEX (or ACTL_WORKER_RANK), as the
// slurm array job does. Run 0 copies the job files there and builds the
// sim, once for all (output in job.build), while the others wait for it:
// concurrent builds would download the same modules into the shared Go
// module cache at the same time, which fails. Each run writes
// job.<run>.start, job.<run>.out and job.<run>.exit (its exit status), and
// the last one to finish writes job.end: the status of the job is from
// these files.
func (sr *Simmer) WriteKubeScript(w io.Writer, jid, args string) {
	pr := sr.Project
	nruns := max(pr.Job.NRuns, 1)
	gohome := path.Join(sr.kubeMount(), "simserver", ".go", kubeName(pr.User))
	dateCmd := `date '+%Y-%m-%d %T %Z'`
	fmt.Fprintf(w, "#!/bin/bash\n")
	fmt.Fprintf(w, "# simmer job %s: run by each pod of the job\n", jid)
	fmt.Fprintf(w, "R=%s\n", shq(sr.KubeJobPath(jid)))
	fmt.Fprintf(w, "WS=%s\n", shq(sr.kubeSourceDir(jid)))
	fmt.Fprintf(w, "RUN=${JOB_COMPLETION_INDEX:-${ACTL_WORKER_RANK:-0}}\n")
	fmt.Fprintf(w, "NRUNS=%d\n", nruns)
	fmt.Fprintf(w, "export GOCACHE=%s GOMODCACHE=%s\n", shq(gohome+"/cache"), shq(gohome+"/mod"))
	fmt.Fprintf(w, "export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/tmp} # for glfw, which the sims link\n")
	// gomlx XLA downloads its PJRT plugins and the CUDA libraries (~2.5 GB)
	// into ~/.cache/go-xla, and installs them in ~/.local/lib/go-xla, if they
	// are not there. A link to the shared volume for the download cache makes
	// the downloads once for all jobs (the files are hash checked); the install
	// stays local, because the CUDA install removes a directory with its open
	// lock file in it, which fails on NFS.
	fmt.Fprintf(w, "X=%s # gomlx XLA download cache, shared by all jobs\n", shq(gohome+"/go-xla-cache"))
	fmt.Fprintf(w, "mkdir -p \"$X\" \"$HOME/.cache\" && { [ -e \"$HOME/.cache/go-xla\" ] || ln -s \"$X\" \"$HOME/.cache/go-xla\"; }\n")
	fmt.Fprintf(w, "mkdir -p \"$R\" \"$GOCACHE\" \"$GOMODCACHE\"\n")
	fmt.Fprintf(w, "cd \"$R\" || exit 1\n")
	fmt.Fprintf(w, "finish() {\n")
	fmt.Fprintf(w, "\techo $1 > job.$RUN.exit\n")
	fmt.Fprintf(w, "\tif [ $(ls -1 job.*.exit | wc -l) -ge $NRUNS ]; then %s > job.end; fi\n", dateCmd)
	fmt.Fprintf(w, "\texit 0 # the status is in job.$RUN.exit: no retries of failed runs\n")
	fmt.Fprintf(w, "}\n")
	fmt.Fprintf(w, "%s > job.$RUN.start\n", dateCmd)
	exe := path.Join("$R", ".bin", pr.Name+".exe")
	fmt.Fprintf(w, "if [ \"$RUN\" = 0 ]; then\n")
	fmt.Fprintf(w, "\tcp -r \"$WS\"/. \"$R\"/\n")
	fmt.Fprintf(w, "\t%s > job.start\n", dateCmd)
	// build in a copy of the source, so that the build files are not in R
	fmt.Fprintf(w, "\tB=$(mktemp -d)\n")
	fmt.Fprintf(w, "\tcp -r \"$WS\"/. \"$B\"/\n")
	bdir := "$B"
	if pr.Job.SubCmd {
		bdir = "$B/" + pr.Name
	}
	fmt.Fprintf(w, "\tif (cd \"%s\" && go build -mod=mod %s -o \"%s\") > job.build 2>&1; then\n", bdir, pr.Job.BuildArgs, exe)
	fmt.Fprintf(w, "\t\techo ok > .job.built\n")
	fmt.Fprintf(w, "\telse\n")
	fmt.Fprintf(w, "\t\techo failed > .job.built\n")
	fmt.Fprintf(w, "\tfi\n")
	fmt.Fprintf(w, "fi\n")
	fmt.Fprintf(w, "until [ -f .job.built ]; do sleep 2; done\n")
	fmt.Fprintf(w, "if [ \"$(cat .job.built)\" != ok ]; then\n")
	fmt.Fprintf(w, "\t(echo \"the build of the sim failed (job.build):\"; grep -v '^go: downloading' job.build | tail -20) > job.$RUN.out\n")
	fmt.Fprintf(w, "\tfinish build-failed\n")
	fmt.Fprintf(w, "fi\n")
	if pr.SetupScript != "" {
		fmt.Fprintln(w, pr.SetupScript)
	}
	hours := max(pr.Job.Hours, 1)
	if pr.JobScript != "" {
		js := strings.ReplaceAll(pr.JobScript, "$JOB_ARGS", args)
		fmt.Fprintf(w, "# JobScript (the sim executable is $SIM)\nSIM=\"%s\"\n", exe)
		fmt.Fprintf(w, "(\n%s\n) > job.$RUN.out 2>&1\n", js)
	} else {
		fmt.Fprintf(w, "TIMEOUT=; command -v timeout > /dev/null && TIMEOUT=\"timeout %dh\" # Job.Hours\n", hours)
		fmt.Fprintf(w, "$TIMEOUT \"%s\" -nogui -cfg config_job.toml%s %s > job.$RUN.out 2>&1\n", exe, sr.runArgs("$RUN"), args)
	}
	fmt.Fprintf(w, "finish $?\n")
}

// WriteKubeJob writes the manifest of the Indexed Job of the given job,
// with one pod per run, which runs job.sbatch from the uploaded job files.
func (sr *Simmer) WriteKubeJob(w io.Writer, jid string) {
	pr := sr.Project
	k := &pr.Server.K8s
	nruns := max(pr.Job.NRuns, 1)
	cpus := max(pr.Job.CPUsPerTask, 1)
	mem := max(pr.Job.Memory, 1) * cpus
	gpus := max(pr.Job.GPUs, 0)
	labels := sr.kubeLabels(jid)
	fmt.Fprintf(w, "# Kubernetes Job of simmer job %s\n", jid)
	fmt.Fprintf(w, "apiVersion: batch/v1\nkind: Job\nmetadata:\n")
	fmt.Fprintf(w, "  name: %s\n  namespace: %s\n", sr.kubeJobName(jid), sr.kubeNamespace())
	fmt.Fprintf(w, "  labels:\n")
	for _, l := range labels {
		fmt.Fprintf(w, "    %s: %q\n", l[0], l[1])
	}
	fmt.Fprintf(w, "spec:\n")
	fmt.Fprintf(w, "  completionMode: Indexed\n  completions: %d\n  parallelism: %d\n", nruns, nruns)
	fmt.Fprintf(w, "  backoffLimit: 0 # the status is in the files: no retries\n")
	fmt.Fprintf(w, "  template:\n    metadata:\n      labels:\n")
	for _, l := range labels {
		fmt.Fprintf(w, "        %s: %q\n", l[0], l[1])
	}
	fmt.Fprintf(w, "    spec:\n      restartPolicy: Never\n")
	fmt.Fprintf(w, "      %s\n", kubePodSecurity)
	if k.SchedulerName != "" {
		fmt.Fprintf(w, "      schedulerName: %s\n", k.SchedulerName)
	}
	if k.ServiceAccount != "" {
		fmt.Fprintf(w, "      serviceAccountName: %s\n", k.ServiceAccount)
	}
	sr.writeKubeScheduling(w, "      ")
	fmt.Fprintf(w, "      containers:\n      - name: sim\n        image: %s\n", k.Image)
	fmt.Fprintf(w, "        command: [bash, %s]\n", path.Join(sr.kubeSourceDir(jid), "job.sbatch"))
	fmt.Fprintf(w, "        %s\n", kubeContainerSecurity)
	fmt.Fprintf(w, "        env:\n")
	fmt.Fprintf(w, "        - {name: HOME, value: /tmp} # nobody has no home\n")
	fmt.Fprintf(w, "        - {name: NVIDIA_DRIVER_CAPABILITIES, value: all} # graphics, for Vulkan\n")
	fmt.Fprintf(w, "        - {name: SIMMER_JOB, value: %s}\n", jid)
	fmt.Fprintf(w, "        resources:\n")
	fmt.Fprintf(w, "          requests: {cpu: \"%d\", memory: %dGi", cpus, mem)
	if gpus > 0 {
		fmt.Fprintf(w, ", nvidia.com/gpu: %d", gpus)
	}
	fmt.Fprintf(w, "}\n          limits: {memory: %dGi", mem)
	if gpus > 0 {
		fmt.Fprintf(w, ", nvidia.com/gpu: %d", gpus)
	}
	fmt.Fprintf(w, "}\n")
	fmt.Fprintf(w, "        volumeMounts:\n        - name: shared\n          mountPath: %s\n", sr.kubeMount())
	fmt.Fprintf(w, "      volumes:\n      - name: shared\n        persistentVolumeClaim:\n          claimName: %s\n", sr.kubePVC())
}

// SubmitKube submits the given job as a Kubernetes Job, from its local
// job directory, which is the current one after, returning its name.
func (sr *Simmer) SubmitKube(jid, args string) string {
	name, err := sr.kubeSubmit(jid, args)
	if err != nil {
		core.ErrorSnackbar(sr, err)
		return ""
	}
	sr.GetMeta(jid)
	return name
}

// kubeWriteJobFiles goes to the local directory of the given job, and
// writes the job.nruns and job.sbatch files of the job there.
func (sr *Simmer) kubeWriteJobFiles(jid, args string) error {
	cd {sr.JobPath(jid)}
	if sr.Project.Server.K8s.Image == "" || sr.kubeNamespace() == "" {
		return errors.New("Kubernetes jobs need the Server K8s Namespace and Image: set them with Edit project")
	}
	goalib.WriteFile("job.nruns", strconv.Itoa(max(sr.Project.Job.NRuns, 1)))
	var b bytes.Buffer
	sr.WriteKubeScript(&b, jid, args)
	return os.WriteFile("job.sbatch", b.Bytes(), 0755)
}

// kubeSubmit writes the job files of the given job, uploads them, and
// applies its Job, returning its name, which it also writes to job.job.
func (sr *Simmer) kubeSubmit(jid, args string) (string, error) {
	sr.kubeStart()
	if err := sr.kubeWriteJobFiles(jid, args); err != nil {
		return "", err
	}
	var b bytes.Buffer
	sr.WriteKubeJob(&b, jid)
	if err := os.WriteFile("job.yaml", b.Bytes(), 0644); err != nil {
		return "", err
	}
	if err := sr.kubeUpload(jid); err != nil {
		return "", err
	}
	ns := sr.kubeNamespace()
	kubectl -n {ns} apply -f job.yaml
	if err := goalError(); err != nil {
		return "", err
	}
	name := sr.kubeJobName(jid)
	goalib.WriteFile("job.job", name)
	return name, nil
}

// kubeUpload uploads the files of the current (local job) directory to
// the .src directory of the results directory of the given job on the
// shared volume, through the helper pod, as a tar.gz.
func (sr *Simmer) kubeUpload(jid string) error {
	files, err := baremetal.AllFiles("./", ".*") // no .DS_Store etc
	if err != nil {
		return err
	}
	f, err := os.CreateTemp("", "simmer-*.tgz")
	if err != nil {
		return err
	}
	tgz := f.Name()
	defer os.Remove(tgz)
	err = baremetal.TarFiles(f, "./", true, files...)
	f.Close()
	if err != nil {
		return err
	}
	src := shq(sr.kubeSourceDir(jid))
	return sr.kubeExecFrom("rm -rf "+src+" && mkdir -p "+src+" && cd "+src+" && tar xzf -", tgz)
}

// kubeJobFiles returns the names of the job.* files in the results
// directory of the given job on the shared volume.
func (sr *Simmer) kubeJobFiles(jid string) ([]string, error) {
	out, err := sr.kubeExec("cd " + shq(sr.KubeJobPath(jid)) + " 2>/dev/null && ls -1 job.* 2>/dev/null; true")
	return goalib.SplitLines(strings.TrimSpace(out)), err
}

// JobStatusKube updates the status of the given job, in the current
// (local job) directory, returning it (see [Simmer.kubeRunsStatus]), with
// the status of its Job from kubectl in job.squeue, as its ServerStatus.
func (sr *Simmer) JobStatusKube(jid string) string {
	sr.kubeStart()
	if name := strings.TrimSpace(goalib.ReadFile("job.job")); name != "" {
		ns := sr.kubeNamespace()
		st := $[kubectl -n {ns} get job {name} --no-headers -o wide < /dev/null]$
		goalib.WriteFile("job.squeue", strings.Join(strings.Fields(st), " "))
	}
	return sr.kubeRunsStatus(jid)
}

// kubeRunsStatus updates the status of the given job, in the current
// (local job) directory, returning it: Pending, Running:n, Failed:n
// (with n runs that failed, once all are done), or Done, without the
// :n for one run (see [statusCount]). The status is from the job.<run>.start and job.<run>.exit
// files of the runs in its results directory, whose job.start and job.end
// are copied, with the output of the build and the runs (job.build and
// job.<run>.out), as for the other servers.
func (sr *Simmer) kubeRunsStatus(jid string) string {
	sstat := goalib.ReadFile("job.status")
	files, err := sr.kubeJobFiles(jid)
	if err != nil {
		core.ErrorSnackbar(sr, err)
		return sstat
	}
	nruns := max(sr.jobNRuns(jid), 1)
	nstart, nexit := 0, 0
	var exits, stamps []string
	for _, f := range files {
		switch {
		case f == "job.start" || f == "job.end":
			stamps = append(stamps, f)
		case strings.HasSuffix(f, ".start"):
			nstart++
		case strings.HasSuffix(f, ".exit"):
			nexit++
			exits = append(exits, f)
		}
	}
	rdir := "cd " + shq(sr.KubeJobPath(jid)) + " && "
	nfail := 0
	if len(exits) > 0 {
		out, _ := sr.kubeExec(rdir + "cat " + strings.Join(exits, " "))
		for _, ex := range goalib.SplitLines(strings.TrimSpace(out)) {
			if strings.TrimSpace(ex) != "0" {
				nfail++
			}
		}
	}
	switch {
	case nexit >= nruns && nfail > 0:
		sstat = statusCount("Failed", nfail, nruns)
	case nexit >= nruns:
		sstat = "Done"
	case nstart > 0:
		sstat = statusCount("Running", nstart-nexit, nruns)
	default:
		sstat = "Pending"
	}
	goalib.WriteFile("job.status", sstat)
	for _, f := range stamps { // the time stamps of the job
		if out, err := sr.kubeExec(rdir + "cat " + f); err == nil {
			goalib.WriteFile(f, strings.TrimSpace(out))
		}
	}
	if err := sr.kubeFetch(jid, kubeOutputFiles); err != nil {
		core.ErrorSnackbar(sr, err)
	}
	return sstat
}

// kubeOutputFiles are the globs of the output files of the build and the
// runs of a job.
const kubeOutputFiles = "job.build job.*.out"

// FetchJobKube downloads the results files ([Project.FetchFiles]) of the
// given job from the shared volume, through the helper pod, with the
// output of the build and the runs (job.build and job.<run>.out).
func (sr *Simmer) FetchJobKube(jid string, force bool) {
	sr.kubeStart()
	jpath := sr.JobPath(jid)
	sstat := goalib.ReadFile(filepath.Join(jpath, "job.status"))
	if !force && sstat == "Fetched" {
		return
	}
	if err := sr.kubeFetch(jid, sr.Project.FetchFiles+" "+kubeOutputFiles); err != nil {
		core.ErrorSnackbar(sr, err)
		return
	}
	if sstat == "Finalized" {
		goalib.WriteFile(filepath.Join(jpath, "job.status"), "Fetched")
		goalib.ReplaceInFile(filepath.Join(jpath, "dbmeta.toml"), "\"Finalized\"", "\"Fetched\"")
	}
}

// kubeFetch downloads the files of the given job that match the given
// globs from its results directory on the shared volume, through the
// helper pod, into its local job directory.
func (sr *Simmer) kubeFetch(jid, globs string) error {
	jpath := sr.JobPath(jid)
	// the files that match the globs, as a tar.gz on stdout, to a file:
	// output as a string would lose a final newline
	script := fmt.Sprintf("cd %s || exit 1\nset --\nfor f in %s; do [ -f \"$f\" ] && set -- \"$@\" \"$f\"; done\n[ $# -gt 0 ] && tar czf - \"$@\"\ntrue", shq(sr.KubeJobPath(jid)), globs)
	tgz := filepath.Join(jpath, ".fetch.tgz")
	defer os.Remove(tgz)
	if err := sr.kubeExecTo(script, tgz); err != nil {
		return err
	}
	fi, err := os.Stat(tgz)
	if err != nil || fi.Size() == 0 {
		return nil
	}
	f, err := os.Open(tgz)
	if err != nil {
		return err
	}
	defer f.Close()
	return baremetal.Untar(f, jpath, true)
}

// CancelJobsKube cancels the given jobs, by deleting their Jobs, with
// their pods. Their results on the shared volume are kept.
func (sr *Simmer) CancelJobsKube(jobs []string) error {
	var errs []error
	ns := sr.kubeNamespace()
	for _, jid := range jobs {
		sr.kubeStart() // each job is independent
		name := sr.ValueForJob(jid, "ServerJob")
		if name == "" {
			continue
		}
		kubectl -n {ns} delete job {name} --ignore-not-found --wait=false < /dev/null
		if err := goalError(); err != nil {
			errs = append(errs, err)
			continue
		}
		goalib.WriteFile(filepath.Join(sr.JobPath(jid), "job.status"), "Canceled")
		sr.GetMeta(jid)
	}
	return errors.Join(errs...)
}

// activeJobsKube returns those of the given jobs that are still pending
// or running, and the others, from the status in the jobs table.
func (sr *Simmer) activeJobsKube(jobs []string) (active, others []string) {
	for _, jid := range jobs {
		st := sr.ValueForJob(jid, "Status")
		if strings.HasPrefix(st, "Running") || strings.HasPrefix(st, "Pending") || st == "Submitted" {
			active = append(active, jid)
		} else {
			others = append(others, jid)
		}
	}
	return
}

// DeleteJobsKube deletes the given jobs: their Jobs, if they are still
// there, and their results directories on the shared volume.
func (sr *Simmer) DeleteJobsKube(jobs []string) error {
	var errs []error
	ns := sr.kubeNamespace()
	for _, jid := range jobs {
		sr.kubeStart() // each job is independent
		if name := sr.ValueForJob(jid, "ServerJob"); name != "" {
			[kubectl -n {ns} delete job {name} --ignore-not-found --wait=false < /dev/null]
		}
		if err := sr.kubeDeleteResults(jid); err != nil {
			errs = append(errs, err)
		}
	}
	return errors.Join(errs...)
}

// deleteJobsKube deletes the given jobs of the Kube or Astera server.
func (sr *Simmer) deleteJobsKube(jobs []string) error {
	if sr.Project.Server.Server == Astera {
		return sr.DeleteJobsAstera(jobs)
	}
	return sr.DeleteJobsKube(jobs)
}

// kubeDeleteResults deletes the results directory of the given job on
// the shared volume. On NFS, rm -rf can leave some files of a directory,
// whose listing skips entries as they are deleted ("Directory not empty"),
// so it tries again, a few times.
func (sr *Simmer) kubeDeleteResults(jid string) error {
	r := shq(sr.KubeJobPath(jid))
	_, err := sr.kubeExec(fmt.Sprintf("for i in 1 2 3 4; do rm -rf %s 2>/dev/null; [ -e %s ] || exit 0; sleep 1; done; rm -rf %s", r, r, r))
	return err
}

// QueueKube shows the Jobs and pods of the user in the namespace.
func (sr *Simmer) QueueKube() {
	sr.kubeStart()
	ts := sr.Tabs.AsLab()
	ns := sr.kubeNamespace()
	sel := "app.kubernetes.io/managed-by=simmer,simmer/user=" + kubeName(sr.Project.User)
	jobs := $[kubectl -n {ns} get jobs -l {sel} -o wide < /dev/null]$
	pods := $[kubectl -n {ns} get pods -l {sel} -o wide < /dev/null]$
	ts.EditorString("Queue", jobs+"\n"+strings.Repeat("#", 60)+"\n"+pods+"\n"+time.Now().Format(sr.Project.TimeFormat))
}
